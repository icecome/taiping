{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@taiping/content-model": ["../../packages/content-model/src/index.ts"],
      "@taiping/content-model/*": ["../../packages/content-model/src/*"],
      "@taiping/shared-utils": ["../../packages/shared-utils/src/index.ts"],
      "@taiping/shared-utils/*": ["../../packages/shared-utils/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
