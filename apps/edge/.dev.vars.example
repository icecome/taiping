# 复制为 .dev.vars（已 gitignore）后填写本地密钥
SESSION_SECRET=please-change-me-to-a-long-random-string

# 管理员账号（可选）：仅用于首次播种到 D1 的 admins 表。
# 两项需同时配置；表非空后不再读取，改口令请到后台「设置 → 账号」。
# 若不配置，首次打开后台时走「初始化管理员」注册流程创建账号。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# 可选：Git 镜像导出
GITHUB_TOKEN=
GITHUB_MIRROR_REPO=

# 可选：邮件通知（Resend）— 评论回复通知与口令重置所需
# 未配置时相关流程降级为「跳过发信」而非报错
RESEND_API_KEY=
RESEND_FROM=

# 可选：访客直接回信（多轮对话）
# 需在 Resend 配置域名 MX 与 webhook，未配置时入站端点一律拒绝
INBOUND_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=

# 可选：后台入口路径，默认 /admin。改动后旧路径即失效
# ADMIN_PATH=/admin

# 站点信息（标题/作者/描述/地址）不在此配置，统一在后台「设置」中管理。
