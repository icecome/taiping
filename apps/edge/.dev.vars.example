# 复制为 .dev.vars（已 gitignore）后填写本地密钥
SESSION_SECRET=please-change-me-to-a-long-random-string

# 管理员账号：仅用于首次播种到 D1 的 admins 表。
# 表非空后不再读取，改口令请到后台「设置 → 账号」。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 可选：Git 镜像导出
GITHUB_TOKEN=
GITHUB_MIRROR_REPO=

# 可选：邮件通知（Resend）— 口令重置与后续通知所需
# 未配置时相关流程降级为「跳过发信」而非报错
RESEND_API_KEY=
RESEND_FROM=

# 可选：后台入口路径，默认 /admin。改动后旧路径即失效
# ADMIN_PATH=/admin

# 站点信息（标题/作者/描述/地址）不在此配置，统一在后台「设置」中管理。
