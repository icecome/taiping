{
  "name": "@taiping/edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate:local": "wrangler d1 migrations apply taiping-blog --local",
    "db:migrate:remote": "wrangler d1 migrations apply taiping-blog --remote"
  },
  "dependencies": {
    "@taiping/content-model": "workspace:*",
    "@taiping/renderer": "workspace:*",
    "@taiping/shared-utils": "workspace:*",
    "@taiping/theme-zhuosu": "workspace:*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
