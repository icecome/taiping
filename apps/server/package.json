{
  "name": "@taiping/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "太平 CMS 服务端：Hono API + 前台 SSR 主题 + Cloudflare 绑定",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --port 8787",
    "db:generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local --config ../../wrangler.jsonc",
    "db:seed": "wrangler d1 execute DB --local --config ../../wrangler.jsonc --file=./seed/seed.sql"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.14",
    "marked": "^18.1.1",
    "pinyin-pro": "^3.27.0",
    "zod": "^4.6.7"
  }
}
