{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taiping-blog",
  "main": "apps/server/src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "apps/console/dist",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taiping-blog",
      "database_id": "local",
      "migrations_dir": "apps/server/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "taiping-media"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_BASE_URL": "http://127.0.0.1:8787",
    "CONSOLE_ORIGIN": "http://localhost:5173"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
